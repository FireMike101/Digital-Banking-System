{
  "name": "digital-banking-system",
  "version": "1.0.0",
  "private": true,
  "description": "Beginner digital banking backend using Express and MongoDB",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
